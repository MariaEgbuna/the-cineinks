  // Review: category Review, medium label plus Review, with a score
  "CineInks Review": {
    "prefix": "review",
    "scope": "markdown",
    "description": "Review post: frontmatter and cover image",
    "body": [
      "---",
      "title: \"${1:Post title}\"",
      "slug: ${2:review-title-year}",
      "date: ${CURRENT_YEAR}-${CURRENT_MONTH}-${CURRENT_DATE}T${CURRENT_HOUR}:${CURRENT_MINUTE}:00.000+01:00",
      "category: Review",
      "labels:",
      "  - ${3|Movies,Series,Anime,KDrama|}",
      "  - Review",
      "score: ${4:7.5}",
      "excerpt: \"${5:One sentence with the core take.}\"",
      "coverImage: /images/posts/${2}/image-1.jpg",
      "featured: false",
      "---",
      "![REVIEW: ${6:Movie Title (Year)}](/images/posts/${2}/image-1.jpg)",
      "",
      "$0"
    ]
  },

